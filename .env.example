# ==========================================
# CLINICAL TRIAGE GATEWAY - ENV TEMPLATE
# ==========================================
# SECURITY WARNING: Never commit the actual .env file to version control.
# Copy this file to .env and populate with production secrets.

# 1. Domain & Network Configuration
DOMAIN_NAME=clinical-gateway.internal
SUBDOMAIN=n8n-triage

# 2. API Keys & Authentication
# Required for LLM Semantic Routing
GROQ_API_KEY=gsk_enter_your_secure_api_key_here
# Internal Auth between n8n and FastAPI Gateway
GATEWAY_SECRET_TOKEN=generate_a_strong_jwt_or_hash_here

# 3. n8n Orchestration Optimization
# Enforce strict data pruning for medical compliance (HIPAA/SATUSEHAT)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168 # Delete records after 7 days
NODE_ENV=production
